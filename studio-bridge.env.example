# Copy these entries into the existing untracked .env. Do not replace the
# existing MSP configuration/prompts. No actual keys belong in this example.
MSP_BRIDGE_PORT=8081
# Optional: blank permits local loopback calls without a key.
MSP_BRIDGE_API_KEY=
STUDIO_BASE_URL=http://127.0.0.1:8888/v1
# Optional when Studio's keyless inference access is enabled.
STUDIO_API_KEY=
# Exact model ID from Studio's GET /v1/models, not msp or msp-gemma.
STUDIO_MODEL=
