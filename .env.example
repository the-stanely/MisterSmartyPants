# websearchMCP.py defaults
# This file contains default configuration values for websearchMCP.py.
# Template only: leave passwords, tokens, and API keys blank. Put real secrets in
# your untracked .env file, never in this example file.

# Optional comma-separated unlock passwords.
# Leave blank for no session lock. Set one or more values before exposing the web UI.
PASSWORD=

# Optional WebAuthn relying-party ID for passkey unlocks. Leave blank to use the
# hostname that serves the app; set this to your public hostname when deployed.
PASSKEY_RP_ID=

# Model configuration
OLLAMA_API=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=1200
QUESTION=Tell me about the band Coldplay.
REQUEST_TIMEOUT_SECONDS=20
DDGS_TIMEOUT_SECONDS=20
SEARCH_MODES=news,text
SEARCH_NEWS_LIMIT=10
SEARCH_TEXT_LIMIT=20
FETCH_TOP_N=5
FETCH_SURVIVOR_N=20
FETCH_WORKERS=4
OLLAMA_NUM_CTX=65535
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=2048
OLLAMA_NUM_THREAD=12

# API keys
HF_TOKEN=
GITHUB_TOKEN=

# Final LLM provider. Set USE_OPENROUTER=true to route every final LLM request
# through OpenRouter; models are tried in the listed order after a failed request.
USE_OPENROUTER=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHAIN=openai/gpt-5.4-nano,openai/gpt-oss-120b,nvidia/nemotron-3-super-120b-a12b,inclusionai/ling-2.6-flash,amazon/nova-micro-v1,inclusionai/ring-2.6-1t,qwen/qwen3-32b
# Optional dedicated chains for the Ollama-compatible decider/query builder and summaries.
# Empty values fall back to OPENROUTER_MODEL_CHAIN.
OR_DECIDER_MODEL=inclusionai/ling-2.6-flash,amazon/nova-micro-v1
# Empty uses OPENROUTER_MODEL_CHAIN, so the planner shares the primary answer-model fallback chain.
OR_PLANNER_MODEL=
OR_SUMMARY_MODEL=inclusionai/ling-2.6-flash,amazon/nova-micro-v1
# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=

# Decider configuration
SUMMARIZE_EXCERPTS=0
SUMMARIZE_EXCERPTS_MIN_CHARS=100000
SUMMARY_PROVIDER=ollama
SEARCH_DECIDER=planner     # Options: planner, python, ollama
DECIDER_MODEL=Qwen/Qwen2.5-0.5B-Instruct
SUMMARY_MODEL=gemma2:2B
OLD_SUMMARY_MODEL=qwen2.5:0.5b-instruct
OLD_OLLAMA_MODEL=llama3.2:latest
RELEVANCY_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RELEVANCY_THRESHOLD=0.0
DECIDER_LOCAL_ONLY=0
DECIDER_SUMMARY_MAX_TOKENS=300
DECIDER_SUMMARY_PROMPT="User question:\n{user_question}\n\nWrite a summary of the article focusing on information that helps answer the user question. Preserve dates, names, numbers, and source-specific claims. Do not conflate facts, or add information not present in the article.\n\nArticle:\n{excerpt_text}"
PYTHON_GENERATION_NO_THINK=1
PYTHON_GENERATION_NO_THINK_INSTRUCTION=/no_think
DECIDER_RELEVANCE_ENABLED=1
DECIDER_RELEVANCE_EXCERPT_CHARS=1200

# Search configuration
SEARCH_ENABLED=1
FORCE_SEARCH_MARKERS=
UNUSED_FORCE_SEARCH_MARKERS=late breaking,latest,today,yesterday,current,currently,last month,last week,new,news,newly,newest,recent,recently,weather,search,look up,find
DDGS_TEXT_BACKEND=auto
DDGS_NEWS_BACKEND=auto
DDGS_REGION=us-en
DDGS_SAFESEARCH=moderate
DDGS_TIMELIMIT=
SEARCH_META_ENRICH_ENABLED=1
SEARCH_META_ENRICH_LIMIT=5
SEARCH_CONTEXT_HISTORY_MAX_CHARS=0
ROUTING_CONTEXT_MAX_CHARS=6000
SESSION_COOKIE_MAX_AGE_SECONDS=2592000
# Set to 1 when serving over HTTPS; leave 0 for local HTTP development.
SESSION_COOKIE_SECURE=0
SEARCH_ONLY_TOP_N=10
PPEND_SOURCE_LINKS=1
SOURCE_LINKS_MAX=5

# Prompts
ANSWER_FROM_RESULTS_PROMPT="Today is {date-time}. Attached is recent web search data to update your knowledge training. It is accurate. Use it to augment your training knowledge. Pay attention to the dates in the web search data. The fetched_pages list is ordered by relevance when current information is requested. Include source URLs when available."
OLD_ANSWER_FROM_RESULTS_PROMPT="Today is {date-time}. Attached is recent web search data to update your knowledge training. It is accurate. Don't question it. Use your training knowledge for background. Do not override or contradict current facts from this web search data with memory. Pay attention to the dates in the web search data. The fetched_pages list is ordered by recency and relevance when current information is requested. Mention source links."
ANSWER_FROM_RESULTS_EXTRA_SYSTEM_PROMPT="You have been given current web search data in this conversation. Add your own analysis or context if needed to answer the user question."
ANSWER_FROM_RESULTS_EXTRA_SYSTEM_PROMPT="You have been given current web search data in this conversation. Do not say you lack web access or cannot access current information when web search data is provided. If the provided web search data is insufficient, add your own analysis or context."
QWEN_DECIDER_SYSTEM_PROMPT="Today is {date-time}. Decide if web search is needed for the latest user request. Return exactly one word: SEARCH or ANSWER. Do not explain. Never return RESEARCH. SEARCH means use the internet. ANSWER means no internet. Choose SEARCH if question specifically requires current or recent information. Choose ANSWER only when stable general knowledge is enough. Examples: \"Explain why the Roman Empire fell.\" -> ANSWER. \"What is Nvidia stock doing today?\" -> SEARCH. \"How does photosynthesis work?\" -> ANSWER. \"Are reviews good for the newest Framework laptop?\" -> SEARCH."
QUERY_BUILDER_SYSTEM_PROMPT="Convert the latest user request into a concise Google web search query. Use preceding conversation only to resolve references in that latest request. Return only query keywords, nothing else. Do not rephrase as a question. Do not add words like 'up to date', 'information', 'info', 'details', 'latest news'. No JSON, no explanation, no punctuation."
PLANNER_SYSTEM_PROMPT="Decide whether the latest user request needs web search. Use preceding conversation only to resolve references in the latest request. Return exactly one JSON object and nothing else. For general knowledge, advice, explanation, writing, or analysis that does not need current information, return {\"action\":\"ANSWER\"}. For current facts, availability, prices, news, live status, or requests to look something up, return {\"action\":\"SEARCH\",\"query\":\"concise search keywords\"}. The query must be one line, under 200 characters, and contain only the search keywords."
OLLAMA_DECIDER_SYSTEM_PROMPT="This is a YES or NO question. The user said: \"{user_prompt}\". Say YES if the topic can be easily answered with general knowledge. Say NO if the topic needs current,recent, or real-time information. Justify your answer."
OLD_OLLAMA_DECIDER_SYSTEM_PROMPT="This is a YES or NO question. The user said: \"{user_prompt}\". Say YES if the topic is in your knowledge set. Say NO if the topic is more current than your training. Justify your answer."
MEMORY_ANSWER_SYSTEM_PROMPT="Answer directly from general knowledge and prior chat context only."

