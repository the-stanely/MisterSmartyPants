# websearchMCP.py defaults
# This file contains default configuration values for websearchMCP.py.

# API and model configuration
OLLAMA_API=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=1200
QUESTION=Tell be about the band Coldplay.
REQUEST_TIMEOUT_SECONDS=20
SEARCH_MODES=news,text
FETCH_TOP_N=5
FETCH_SCAN_LIMIT=20
FETCH_CANDIDATE_N=5
FETCH_WORKERS=4
OLLAMA_NUM_CTX=65535
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=4096

# Decider configuration
SUMMARIZE_EXCERPTS_WITH_DECIDER=1
SEARCH_DECIDER=python      # Options: python, ollama
DECIDER_MODEL=Qwen/Qwen2.5-0.5B-Instruct
SUMMARY_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
RELEVANCY_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RELEVANCY_THRESHOLD=0.0
DECIDER_LOCAL_ONLY=0
DECIDER_SUMMARY_MAX_TOKENS=300
DECIDER_SUMMARY_PROMPT="Write a summary of the following article:\n\n{excerpt_text}"
PYTHON_GENERATION_NO_THINK=1
PYTHON_GENERATION_NO_THINK_INSTRUCTION=/no_think
DECIDER_RELEVANCE_ENABLED=1
DECIDER_RELEVANCE_EXCERPT_CHARS=1200

# Search configuration
FORCE_SEARCH_MARKERS=latest,today,yesterday,current,news,recent,newest,weather,search,look up,find

# Prompts
ANSWER_FROM_RESULTS_PROMPT="Today is {date-time}. Attached is recent web search data to update your knowledge training. It is accurate. Don't question it. Use your training knowledge for background. Do not override or contradict current facts from this web search data with memory. Pay attention to the dates in the web search data. The fetched_pages list is ordered by recency and relevance when current information is requested. Mention source links."
ANSWER_FROM_RESULTS_EXTRA_SYSTEM_PROMPT="You have been given current web search data in this conversation. Do not say you lack web access or cannot access current information when web search data is provided. If the provided web search data is insufficient, add your own analysis or context."
QWEN_DECIDER_SYSTEM_PROMPT="Today is {date-time}. Decide if web search is needed for the latest user request. Return exactly one word: SEARCH or ANSWER. Do not explain. Never return RESEARCH. SEARCH means use the internet. ANSWER means no internet. Choose SEARCH if question specifically requires current or recent information. Choose ANSWER only when stable general knowledge is enough. Examples: \"Explain why the Roman Empire fell.\" -> ANSWER. \"What is Nvidia stock doing today?\" -> SEARCH. \"How does photosynthesis work?\" -> ANSWER. \"Are reviews good for the newest Framework laptop?\" -> SEARCH."
QUERY_BUILDER_SYSTEM_PROMPT="Convert the user request into a concise web search query. Use prior chat context if helpful. Return only the query text, no quotes, no JSON, no explanation."
OLLAMA_DECIDER_SYSTEM_PROMPT="Decide if web search is required to answer the user's latest request. For anything time-sensitive, recent, or uncertain, choose SEARCH. Return exactly one line in this format: DECISION|REASON. DECISION must be either SEARCH or ANSWER. If unsure, choose SEARCH."
MEMORY_ANSWER_SYSTEM_PROMPT="Answer directly from general knowledge and prior chat context only. Do not claim web verification."
